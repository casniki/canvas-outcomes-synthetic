model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Outcome Results","Outcome Question Results","Rubric Assessments","Enrollments","Learning Outcome","Learning Outcome Group","User","Course","Course Section","Assignment","Rubric Association","Date","Mastery Scale","Calculation Method","DataFolder","Results Start Date","Program Code Map"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table 'Outcome Results'
ref table 'Outcome Question Results'
ref table 'Rubric Assessments'
ref table Enrollments
ref table 'Learning Outcome'
ref table 'Learning Outcome Group'
ref table User
ref table Course
ref table 'Course Section'
ref table Assignment
ref table 'Rubric Association'
ref table Date
ref table 'Mastery Scale'
ref table 'Calculation Method'
ref table 'Program Code Map'

ref cultureInfo en-US

